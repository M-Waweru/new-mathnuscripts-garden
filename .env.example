# Copy to `.env` for local Netlify dev. Never commit real keys.
# Run: npm run dev  (Netlify dev serves /api/ask — not plain quartz preview)
NVIDIA_API_KEY=
# Optional overrides (defaults shown):
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=z-ai/glm-5.3-flash
# List models: curl -H "Authorization: Bearer $NVIDIA_API_KEY" https://integrate.api.nvidia.com/v1/models
# Generation params (temperature 0.5, top_p 1, max_tokens 1024) live in netlify/ask-core.mjs
